# NVM Lazy loading
export NVM_DIR="$HOME/.nvm"
lazy_nvm() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm() { lazy_nvm; nvm "$@"; }
node() { lazy_nvm; node "$@"; }
npm() { lazy_nvm; npm "$@"; }
npx() { lazy_nvm; npx "$@"; }


# List of folders to add to path
PATH_DIRS=(
    "$HOME/.local/share/pnpm/bin"                       # PNPM
    "$HOME/.cargo/bin"                                  # Cargo
    "$HOME/.local/share/SLSsteam/path"                  # SLSsteam
)

for dir in "${PATH_DIRS[@]}"; do
    # Only add to path if the folder exist and if it isn't already in the path.
    if [ -d "$dir" ] && [[ ":$PATH:" != *":$dir:"* ]]; then
        export PATH="$dir:$PATH"
    fi
done
unset PATH_DIRS dir


