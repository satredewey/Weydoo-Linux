# Display public IPv4 and IPv6 with clean formatting
function myip() {
    printf '──────────── My IP Addresses ────────────\n'
    printf 'IPv4: '
    curl -4 -s --connect-timeout 2 ifconfig.me || printf 'Not available'
    printf '\nIPv6: '
    curl -6 -s --connect-timeout 2 ifconfig.me || printf 'Not available'
    printf '\n─────────────────────────────────────────\n'
}

# Human readable disk usage (Mo/Go)
function df() {
    command df -h 2>/dev/null \
    | awk '
        NR==1;
        NR>1 && $1 !~ /\/dev\/loop/ && $1 !~ /efivarfs/ {
            print $0 | "sort -k6,6"
        }
      ' \
    | sed -E '
        s/([0-9]{1,2}%)/ \x1b[32m\1\x1b[0m/g
        s/(9[0-9]%|100%)/ \x1b[31m\1\x1b[0m/g
    '
}

# Update package list and upgrade them
function update() {
    sudo apt update
    sudo apt upgrade -y
    sudo apt autoremove -y
}

# Full upgrade allowing to install or remove packages to satisfy dependencies
function full-update() {
    read -p "Do you want to execute a full upgrade ? [y/N] " -n 1 -r
    echo "" # Ajoute un saut de ligne propre après la saisie

    # Vérifie si la réponse est 'y' ou 'Y'
    if [[ ! $REPLY =~ ^[YyOo]$ ]]; then
        echo "Opération annulée."
        return 1
    fi

    sudo apt update
    sudo apt full-upgrade -y
    sudo apt autoremove -y
}

# Automaticly extract tar.gz, zip, rar, etc.
function extract() {
  if [ -f "$1" ] ; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.bz2)       bunzip2 "$1"     ;;
      *.rar)       unrar x "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xvf "$1"     ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         compress -d "$1" ;;
      *.7z)        7z x "$1"        ;;
      *)           echo "'$1' ne peut pas être extrait via extract()" ;;
    esac
  else
    echo "'$1' n'est pas un fichier valide"
  fi
}

# Reload the ~/.bashrc
function reload() {
    clear
    source ~/.bashrc && echo "~/.bashrc reloaded"
}

# Create a folder and enter it
function mkcd() {
    mkdir -p "$1" && cd "$1" || return
}



